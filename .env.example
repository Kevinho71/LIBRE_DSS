# Plantilla de variables de produccion. Copiar a .env.production y completar.
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST-pooler.REGION.aws.neon.tech/BASE?sslmode=require
JWT_SECRET=<openssl rand -hex 32>
JWT_EXPIRES_IN=24h
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DSS_HABILITAR_SIMULACION=false
AWS_S3_BUCKET=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
CORS_ORIGINS=
VITE_API_URL=/api/v1
